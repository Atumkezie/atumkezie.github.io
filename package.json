{
  "name": "harikrishna-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build-experience.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check public/scripts/environment.js && node --check public/scripts/preferences.js && node --check public/scripts/loading.js && node --check src/scripts/experience.js && node --check src/scripts/scroll.js && node scripts/check-build.mjs",
    "export:review": "node scripts/export-review.mjs && node scripts/check-review.mjs",
    "package": "python3 scripts/package_release.py"
  },
  "dependencies": {
    "astro": "7.4.5",
    "@fontsource-variable/josefin-sans": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
